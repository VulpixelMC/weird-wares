{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "Weird Wares",
	"description": "Weird wares for your wacky world!",
	"authors": [
		"Vulpixel",
		"Sylv",
		"Oliver-makes-code (Asset Contributor)"
	],
	"contact": {
		"homepage": "https://sylv.gay/vulpixel",
		"sources": "https://github.com/VulpixelMC/weird-wares"
	},
	"license": "",
